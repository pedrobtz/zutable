 * Altered from the original: C instead of C++ templates; the byte offset
 * is a run-time argument instead of a template parameter; a record's
 * bytes are ZT_SORT_BYTE, most significant first, and every byte of the
 * record is a key byte (the row last), so there is no next_sort; the
 * fallback below StdSortThreshold is the pdqsort port, not std::sort;
 * the four-times unrolled loop is a plain loop.
 */

#define T ZT_SORT_T
#define BYTE ZT_SORT_BYTE

/* The original's thresholds: comparison sort below the first, American
   flag sort below the second, ska byte sort above. */
#define ZT_SKA_STD_THRESHOLD 128
#define ZT_SKA_AF_THRESHOLD 1024

ZT_INLINE void ZT_SORT_FN(zt_ska_from)(T *b, T *e, int d, int nbytes);

/* StdSortIfLessThanThreshold: 1 when [b, e) needed no radix pass. */
ZT_INLINE int ZT_SORT_FN(zt_ska_small)(T *b, T *e) {
  ptrdiff_t n = e - b;
  if (n <= 1) return 1;
  if (n >= ZT_SKA_STD_THRESHOLD) return 0;
  ZT_SORT_FN(zt_pdqsort)(b, e);
  return 1;
}

ZT_INLINE void ZT_SORT_FN(zt_american_flag)(T *b, T *e, int d, int nbytes) {
  size_t count[256] = {0}, offset[256], next_offset[256];
  for (T *it = b; it != e; ++it) ++count[BYTE(*it, d)];
  size_t total = 0;
  unsigned char remaining[256];
  int num_partitions = 0;
  for (int i = 0; i < 256; ++i) {
    if (!count[i]) continue;
    offset[i] = total;
    total += count[i];
    next_offset[i] = total;
    remaining[num_partitions++] = (unsigned char) i;
  }
  if (num_partitions > 1) {
    const unsigned char *current_block_ptr = remaining;
    int current_block = *current_block_ptr;
    const unsigned char *last_block = remaining + num_partitions - 1;
    T *it = b;
    T *block_end = b + next_offset[current_block];
    T *last_element = e - 1;
    for (;;) {
      int block = (int) BYTE(*it, d);
      if (block == current_block) {
        ++it;
        if (it == last_element) break;
        if (it == block_end) {
          for (;;) {
            ++current_block_ptr;
            if (current_block_ptr == last_block) goto recurse;
            current_block = *current_block_ptr;
            if (offset[current_block] != next_offset[current_block]) break;
          }
          it = b + offset[current_block];
          block_end = b + next_offset[current_block];
        }
      } else {
        size_t o = offset[block]++;
        T t = *it; *it = b[o]; b[o] = t;
      }
    }
  }
recurse:
  if (d + 1 != nbytes) {
    T *partition_begin = b;
    for (int k = 0; k < num_partitions; ++k) {
      size_t end_offset = next_offset[remaining[k]];
      T *partition_end = b + end_offset;
      if (!ZT_SORT_FN(zt_ska_small)(partition_begin, partition_end)) {
        ZT_SORT_FN(zt_ska_from)(partition_begin, partition_end, d + 1, nbytes);
      }
      partition_begin = partition_end;
    }
  }
}

ZT_INLINE void ZT_SORT_FN(zt_ska_byte)(T *b, T *e, int d, int nbytes) {
  size_t count[256] = {0}, offset[256], next_offset[256];
  for (T *it = b; it != e; ++it) ++count[BYTE(*it, d)];
  unsigned char remaining[256];
  size_t total = 0;
  int num_partitions = 0;
  for (int i = 0; i < 256; ++i) {
    if (count[i]) {
      offset[i] = total;
      total += count[i];
      remaining[num_partitions++] = (unsigned char) i;
    }
    next_offset[i] = total;
  }
  /* custom_std_partition over the partitions still holding misplaced
     elements, swapping each element of a partition to its destination. */
  unsigned char *last_remaining = remaining + num_partitions;
  unsigned char *end_partition = remaining + 1;
  while (last_remaining > end_partition) {
    unsigned char *first = remaining;
    unsigned char *stop = last_remaining;
    /* Written out: the original's lambda in custom_std_partition. */
    for (;; ++first) {
      if (first == stop) { last_remaining = stop; goto partitioned; }
      {
        int p = *first;
        size_t begin_offset = offset[p];
        size_t end_offset = next_offset[p];
        int keep = 0;
        if (begin_offset != end_offset) {
          T *it = b + begin_offset;
          size_t c = end_offset - begin_offset;
          for (size_t j = 0; j < c; j++, ++it) {
            unsigned this_partition = BYTE(*it, d);
            size_t o = offset[this_partition]++;
            T t = *it; *it = b[o]; b[o] = t;
          }
          keep = offset[p] != next_offset[p];
        }
        if (!keep) break;
      }
    }
    {
      unsigned char *it = first;
      for (++it; it != stop; ++it) {
        int p = *it;
        size_t begin_offset = offset[p];
        size_t end_offset = next_offset[p];
        int keep = 0;
        if (begin_offset != end_offset) {
          T *x = b + begin_offset;
          size_t c = end_offset - begin_offset;
          for (size_t j = 0; j < c; j++, ++x) {
            unsigned this_partition = BYTE(*x, d);
            size_t o = offset[this_partition]++;
            T t = *x; *x = b[o]; b[o] = t;
          }
          keep = offset[p] != next_offset[p];
        }
        if (!keep) continue;
        unsigned char tmp = *first; *first = *it; *it = tmp;
        ++first;
      }
      last_remaining = first;
    }
  partitioned:;
  }
  if (d + 1 != nbytes) {
    for (unsigned char *it = remaining + num_partitions; it != remaining; --it) {
      int partition = it[-1];
      size_t start_offset = partition == 0 ? 0 : next_offset[partition - 1];
      size_t end_offset = next_offset[partition];
      T *partition_begin = b + start_offset;
      T *partition_end = b + end_offset;
      if (!ZT_SORT_FN(zt_ska_small)(partition_begin, partition_end)) {
        ZT_SORT_FN(zt_ska_from)(partition_begin, partition_end, d + 1, nbytes);
      }
    }
  }
}

/* UnsignedInplaceSorter::sort at byte d. */
ZT_INLINE void ZT_SORT_FN(zt_ska_from)(T *b, T *e, int d, int nbytes) {
  if (e - b < ZT_SKA_AF_THRESHOLD) ZT_SORT_FN(zt_american_flag)(b, e, d, nbytes);
  else ZT_SORT_FN(zt_ska_byte)(b, e, d, nbytes);
}

/* ska_sort of [b, e) on bytes d0 onward, of nbytes. */
ZT_INLINE void ZT_SORT_FN(zt_ska_sort_from)(T *b, T *e, int d0, int nbytes) {
  if (ZT_SORT_FN(zt_ska_small)(b, e)) return;
  ZT_SORT_FN(zt_ska_from)(b, e, d0, nbytes);
}

#undef ZT_SKA_STD_THRESHOLD
#undef ZT_SKA_AF_THRESHOLD
#undef T
#undef BYTE
