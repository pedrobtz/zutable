#!/usr/bin/env Rscript
# The kernel's benchmark harness (design-kernel section 9). Stage 9 runs the
# incumbents alone, so .agents/benchmarks.md holds the bar of section 9.3
# before any kernel code exists; later stages add the kernel's own rows.
#
# Three rules (section 9.2): every oracle's result is reduced to a canonical
# form and compared before a timing is kept; memory is recorded for every
# row (the growth of R's heap across a run, from gc(): what R allocated, not
# the process's peak RSS); the settings each oracle was given are stated.
#
# Usage: Rscript tools/run-benchmarks [n] [out]
#   n    rows (default 1e7), out: a Markdown file (default stdout)
#
# Time an optimised install: `R CMD INSTALL --preclean .` first. Without
# --preclean, R CMD INSTALL reuses object files devtools::load_all() left
# in src/, which are compiled at -O0 (Stage 11 found the Stage 10 table
# timed that way).
args <- commandArgs(trailingOnly = TRUE)
n <- if (length(args) >= 1L) as.numeric(args[[1L]]) else 1e7
out <- if (length(args) >= 2L) args[[2L]] else ""
reps <- 5L
# Sections to run: all, or a comma-separated subset in ZT_BENCH_SECTIONS
# (groups, order, join, reduce).
sections <- strsplit(Sys.getenv("ZT_BENCH_SECTIONS", "groups,order,join,reduce"), ",")[[1L]]
want <- function(section) section %in% sections
has_zutable <- requireNamespace("zutable", quietly = TRUE)
suppressPackageStartupMessages({
  library(collapse)
  library(data.table)
  library(vctrs)
  library(bit64)
})
has_kit <- requireNamespace("kit", quietly = TRUE)
data.table::setDTthreads(1L)
collapse::set_collapse(nthreads = 1L)
set.seed(20261117)

rows <- list()
record <- function(target, oracle, input, fn, canon, settings = "one thread") {
  ref <- canon(fn())
  t <- numeric(reps)
  mem <- NA_real_
  for (r in seq_len(reps)) {
    gc(FALSE)
    m0 <- gc(FALSE)[2L, 2L]
    t[[r]] <- system.time(res <- fn(), gcFirst = FALSE)[["elapsed"]]
    mem <- max(mem, (gc(FALSE)[2L, 2L] - m0), na.rm = TRUE)
  }
  rows[[length(rows) + 1L]] <<- data.frame(
    target = target, oracle = oracle, input = input,
    seconds = stats::median(t), mb = mem, settings = settings,
    canon = I(list(ref)), stringsAsFactors = FALSE)
  invisible(ref)
}

# Every oracle of one row must give the same canonical result.
agree <- function(target) {
  r <- Filter(function(x) x$target == target, rows)
  canons <- lapply(r, function(x) x$canon[[1L]])
  ok <- all(vapply(canons, identical, NA, canons[[1L]]))
  if (!ok) {
    stop("oracles disagree on ", target, ": ",
         paste(vapply(r, function(x) x$oracle, ""), collapse = ", "))
  }
}

group_canon <- function(id) sort(tabulate(match(id, unique(id))))
sums_canon <- function(keys, sums) { o <- order(keys, method = "radix"); round(sums[o], 6) }

# --- inputs ------------------------------------------------------------------
int_key <- function(G) sample.int(.Machine$integer.max, G)[sample.int(G, n, replace = TRUE)]
dbl_key <- function(G) (stats::runif(G) * 1e6)[sample.int(G, n, replace = TRUE)]
k3 <- int_key(1e3)
k5 <- int_key(1e5)
k7 <- int_key(1e7)
v <- stats::runif(n)

# --- groups ------------------------------------------------------------------
if (want("groups")) {
for (spec in list(list("1e3", k3), list("1e5", k5))) {
  tg <- sprintf("groups, one integer key, %s distinct", spec[[1L]])
  x <- spec[[2L]]
  if (has_kit) record(tg, "kit: match(x, funique(x))", "int", function() match(x, kit::funique(x)), group_canon)
  record(tg, "collapse::GRP", "int", function() collapse::GRP(x, sort = FALSE)$group.id, group_canon)
  record(tg, "vctrs::vec_group_id", "int", function() vctrs::vec_group_id(x), group_canon)
  record(tg, "base: match(x, unique(x))", "int", function() match(x, unique(x)), group_canon)
  if (has_zutable) record(tg, "zutable::grp", "int", function() zutable::grp(x)$id, group_canon)
  agree(tg)
}
tg <- "groups, one key, 1e7 distinct"
if (has_kit) record(tg, "kit: match(x, funique(x))", "int", function() match(k7, kit::funique(k7)), group_canon)
record(tg, "collapse::GRP", "int", function() collapse::GRP(k7, sort = FALSE)$group.id, group_canon)
record(tg, "vctrs::vec_group_id", "int", function() vctrs::vec_group_id(k7), group_canon)
if (has_zutable) record(tg, "zutable::grp", "int", function() zutable::grp(k7)$id, group_canon)
agree(tg)
a2 <- int_key(1e3)
b2 <- int_key(1e2)
tg <- "groups, two keys"
record(tg, "collapse::GRP", "int x int", function() collapse::GRP(list(a2, b2), sort = FALSE)$group.id, group_canon)
record(tg, "vctrs::vec_group_id", "int x int", function() vctrs::vec_group_id(data.frame(a2, b2)), group_canon)
if (has_zutable) record(tg, "zutable::grp", "int x int", function() zutable::grp(a2, b2)$id, group_canon)
agree(tg)
tg <- "groups, sort = TRUE, 1e5 distinct"
sorted_ids <- function(id) id[order(k5, method = "radix")][!duplicated(k5[order(k5, method = "radix")])]
record(tg, "collapse::GRP(sort = TRUE)", "int", function() collapse::GRP(k5, sort = TRUE)$group.id, sorted_ids)
if (has_zutable) record(tg, "zutable::grp(sort = TRUE)", "int", function() zutable::grp(k5, sort = TRUE)$id, sorted_ids)
# Axis O (design-kernel 4.2): sort every row, then cut the runs, against
# grp(sort = TRUE), which hashes and sorts only the distinct keys.
if (has_zutable) record(tg, "axis O: key_order() of every row, then runs", "int", function() {
  o <- zutable::key_order(k5)
  xs <- k5[o]
  id <- integer(length(o))
  id[o] <- cumsum(c(TRUE, xs[-1L] != xs[-length(xs)]))
  id
}, sorted_ids)
agree(tg)
# The 9.1 shape: a skewed symbol of about 1e4 values and an hour bucket.
syms <- paste0("S", seq_len(1e4))
sym <- syms[pmin(1e4, ceiling(stats::rexp(n, 1 / 800)))]
hour <- sample.int(24L, n, replace = TRUE)
px <- stats::runif(n, 10, 500)
tg <- "groups, 9.1 market-data input"
record(tg, "collapse::GRP", "chr x int", function() collapse::GRP(list(sym, hour), sort = FALSE)$group.id, group_canon)
if (has_zutable) record(tg, "zutable::grp", "chr x int", function() zutable::grp(sym, hour)$id, group_canon)
if (requireNamespace("duckdb", quietly = TRUE)) {
  con <- DBI::dbConnect(duckdb::duckdb())
  DBI::dbExecute(con, "SET threads = 1")
  duckdb::duckdb_register(con, "taq", data.frame(sym, hour, px))
  record(tg, "duckdb GROUP BY", "chr x int", function() {
    DBI::dbGetQuery(con, "SELECT count(*) n FROM taq GROUP BY sym, hour")$n
  }, function(sz) sort(as.integer(sz)), settings = "threads = 1")
}
agree(tg)
}

# --- order ---------------------------------------------------------------------
if (want("order")) {
dv <- stats::runif(n)
iv <- sample.int(.Machine$integer.max, n, replace = TRUE)
sorted_canon <- function(x) function(o) x[o]
tg <- "order, integer, 1e7 rows"
record(tg, "base order(method = 'radix')", "int", function() order(iv, method = "radix"), sorted_canon(iv))
record(tg, "data.table:::forderv", "int", function() data.table:::forderv(iv), sorted_canon(iv))
if (has_zutable) record(tg, "zutable::key_order", "int", function() zutable::key_order(iv), sorted_canon(iv))
agree(tg)
tg <- "order, double, 1e7 rows"
record(tg, "base order(method = 'radix')", "dbl", function() order(dv, method = "radix"), sorted_canon(dv))
record(tg, "data.table:::forderv", "dbl", function() data.table:::forderv(dv), sorted_canon(dv))
if (has_zutable) record(tg, "zutable::key_order", "dbl", function() zutable::key_order(dv), sorted_canon(dv))
agree(tg)
tg <- "order, n = 100, repeated 1e5 times"
small <- lapply(seq_len(1e5), function(i) stats::runif(100))
small_canon <- function(os) sum(vapply(seq_along(os), function(i) small[[i]][os[[i]]][[1L]], 0))
record(tg, "base order()", "dbl", function() lapply(small, order), small_canon)
if (has_zutable) record(tg, "zutable::key_order", "dbl", function() lapply(small, zutable::key_order), small_canon)
agree(tg)
tg <- "order, sorted input"
sv <- sort(dv)
record(tg, "base order(method = 'radix')", "dbl", function() order(sv, method = "radix"), sorted_canon(sv))
if (has_zutable) record(tg, "zutable::key_order", "dbl", function() zutable::key_order(sv), sorted_canon(sv))
agree(tg)
tg <- "order, reversed input"
rv <- rev(sv)
record(tg, "base order(method = 'radix')", "dbl", function() order(rv, method = "radix"), sorted_canon(rv))
if (has_zutable) record(tg, "zutable::key_order", "dbl", function() zutable::key_order(rv), sorted_canon(rv))
agree(tg)
tg <- "sort of values, double, 1e7 rows"
record(tg, "base sort(method = 'radix')", "dbl", function() sort(dv, method = "radix"), identity)
c5 <- paste0("id", sample.int(1e5))[sample.int(1e5, n, replace = TRUE)]
tg <- "order, character, 1e5 distinct"
record(tg, "base order(method = 'radix')", "chr", function() order(c5, method = "radix"), sorted_canon(c5))
record(tg, "data.table:::forderv", "chr", function() data.table:::forderv(c5), sorted_canon(c5))
agree(tg)
call <- sprintf("u%09d", sample.int(n))
tg <- "order, character, all distinct"
record(tg, "base order(method = 'radix')", "chr", function() order(call, method = "radix"), sorted_canon(call))
agree(tg)
words <- paste0(sample(c(letters, LETTERS, "é"), 1e6, TRUE), sample(letters, 1e6, TRUE))
tg <- "sort, character, collate = TRUE (1e6 rows)"
record(tg, "stringi::stri_order", "chr", function() stringi::stri_order(words), function(o) length(o),
       settings = "locale en")
record(tg, "base sort()", "chr", function() order(words), function(o) length(o),
       settings = "session collation")
}

# --- join and match ------------------------------------------------------------
if (want("join")) {
yk <- sample.int(.Machine$integer.max, 1e6)
xk <- yk[sample.int(1e6, n, replace = TRUE)]
dx <- data.table(k = xk, i = seq_len(n))
dy <- data.table(k = yk, j = seq_len(1e6))
pair_canon <- function(p) { o <- order(p$i, p$j); c(sum(as.numeric(p$i[o]) * 3 + p$j[o]), nrow(p)) }
tg <- "join, inner, one key"
record(tg, "data.table x[y, on =]", "int", function() dy[dx, on = "k", nomatch = NULL, list(i, j)], pair_canon)
record(tg, "base merge()", "int", function() merge(dx, dy, by = "k", sort = FALSE)[, c("i", "j")], pair_canon)
agree(tg)
yk2 <- data.table(a = sample.int(1e3, 1e6, TRUE), b = sample.int(1e3, 1e6, TRUE))
yk2 <- unique(yk2)[, j := .I]
dx2 <- yk2[sample.int(nrow(yk2), n, TRUE), list(a, b)][, i := .I]
tg <- "join, inner, two keys"
record(tg, "data.table x[y, on =]", "int x int", function() yk2[dx2, on = c("a", "b"), nomatch = NULL, list(i, j)], pair_canon)
tg <- "match, one key"
record(tg, "base match()", "int", function() match(xk, yk), identity)
record(tg, "collapse::fmatch", "int", function() collapse::fmatch(xk, yk), identity)
agree(tg)
i64x <- bit64::as.integer64(xk)
i64y <- bit64::as.integer64(yk)
tg <- "match, integer64"
record(tg, "bit64::match.integer64", "i64", function() bit64:::match.integer64(i64x, i64y), identity)
}

# --- reduce --------------------------------------------------------------------
if (want("reduce")) {
for (spec in list(list("1e3", k3), list("1e5", k5), list("1e7", k7))) {
  tg <- sprintf("reduce, sum, %s groups", spec[[1L]])
  g <- collapse::GRP(spec[[2L]], sort = TRUE)
  keys <- g$groups[[1L]]
  record(tg, "collapse::fsum", "dbl", function() collapse::fsum(v, g), function(s) round(as.vector(s), 6))
  record(tg, "base rowsum()", "dbl", function() rowsum(v, g$group.id)[, 1L], function(s) round(as.vector(s), 6))
  agree(tg)
}
g5 <- collapse::GRP(k5)
vs <- replicate(4, stats::runif(n), simplify = FALSE)
tg <- "reduce, four columns"
record(tg, "four collapse f*() calls", "dbl", function() list(collapse::fsum(vs[[1L]], g5), collapse::fmean(vs[[2L]], g5),
  collapse::fmin(vs[[3L]], g5), collapse::fmax(vs[[4L]], g5)), function(l) round(unlist(l), 6))
tg <- "reduce, broadcast = 'subtract'"
record(tg, "collapse::fwithin", "dbl", function() collapse::fwithin(v, g5), function(s) round(sum(s), 4))
}

# --- report --------------------------------------------------------------------
tab <- do.call(rbind, lapply(rows, function(r) r[, c("target", "oracle", "input", "seconds", "mb", "settings")]))
md <- c(
  sprintf("Run on %s: %s, %s, R %s, %s rows, median of %d. Every row's oracles agreed on a canonical result before it was timed.",
          format(Sys.Date()), Sys.info()[["machine"]], utils::sessionInfo()$running,
          paste(R.version$major, R.version$minor, sep = "."), format(n, scientific = TRUE), reps),
  "",
  "| Target (design-kernel 9.3) | Oracle | Input | Seconds | R heap MB | Settings |",
  "| --- | --- | --- | ---: | ---: | --- |",
  sprintf("| %s | %s | %s | %.3f | %.0f | %s |", tab$target, tab$oracle, tab$input, tab$seconds,
          tab$mb, tab$settings)
)
if (nzchar(out)) writeLines(md, out) else writeLines(md)
